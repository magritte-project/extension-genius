{
    "name": "@magritte/extension-genius",
    "private": true,
    "license": "GPL-3.0-only",
    "type": "module",
    "scripts": {
        "dev": "vite --port 5889",
        "start": "vite --port 5888",
        "build": "vite build && tsc",
        "clean": "rm -rf dist",
        "serve": "vite preview",
        "test": "vitest run --passWithNoTests",
        "format": "oxfmt",
        "lint": "oxlint",
        "check": "oxlint && oxfmt --check",
        "check-types": "tsc --noEmit"
    },
    "dependencies": {
        "@magritte/api": "^0.2.1",
        "@magritte/rpc": "^0.2.1",
        "@magritte/sdk": "^0.2.1",
        "@phosphor-icons/react": "^2.1.10",
        "@tanstack/react-query": "^5.106.1",
        "classnames": "^2.5.1",
        "dotenv": "^18.0.9",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "vite-plugin-server-actions": "^1.5.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "oxfmt": "^0.60.0",
        "oxlint": "^1.91.0",
        "oxlint-tsgolint": "^7.0.2006",
        "typescript": "^7.0.2",
        "vite": "^8.3.6",
        "vitest": "^4.1.12"
    },
    "packageManager": "pnpm@12.8.1"
}
