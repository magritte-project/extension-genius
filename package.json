    "dependencies": {
        "@magritte/api": "git+ssh://git@github.com/decarbonization/magritte#path:/packages/api",
        "@magritte/rpc": "git+ssh://git@github.com/decarbonization/magritte#path:/packages/rpc",
        "@magritte/sdk": "git+ssh://git@github.com/decarbonization/magritte#path:/packages/sdk",
        "@phosphor-icons/react": "2.1.10",
        "@tanstack/react-query": "5.101.4",
        "classnames": "2.5.1",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "vite-plugin-server-actions": "1.5.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@types/node": "26.1.2",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.4",
        "oxfmt": "0.60.0",
        "oxlint": "1.75.0",
        "typescript": "7.0.2",
        "vite": "8.1.5",
        "vitest": "4.1.10"
